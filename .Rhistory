# Stress tests for initiate() — messy CSV formats, edge cases, QC flagging.
# Each test creates its own tempfile and cleans up via on.exit().
t0 <- 1700000000  # a stable unix epoch anchor
# ── 1. Simple / clean GPS format ─────────────────────────────────────────────
test_that("initiate() handles a minimal clean GPS CSV", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
utils::write.csv(
data.frame(
unix_time = t0 + seq(0, by = 0.1, length.out = 100),
lat       = 51.5 + seq(0, 0.001, length.out = 100),
lng       = -0.1 + seq(0, 0.001, length.out = 100),
altitude  = 10
),
path, row.names = FALSE
)
tr <- initiate(source = "guess_csv", session = path, verbose = FALSE)
expect_s3_class(tr, "motion_trace")
expect_true(all(c("unix_time", "lat", "lng", "altitude", "is_interpolated") %in% names(tr)))
expect_equal(nrow(tr), 100)
expect_false(is.null(attr(tr, "metadata")))
expect_false(is.null(attr(tr, "quality")))
})
