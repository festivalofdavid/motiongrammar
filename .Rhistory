entry <- attr(tr, "quality")$initiate[[1]]
expect_gt(entry$largest_gap_sec, 10)
expect_true(any(grepl("gap", c(entry$issues, entry$warnings), ignore.case = TRUE)))
})
test_that("initiate() quality log entry contains all provenance fields", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
utils::write.csv(
data.frame(unix_time = t0 + seq_len(30), lat = 51.5, lng = -0.1, altitude = 10),
path, row.names = FALSE
)
tr    <- initiate(source = "guess_csv", session = path, verbose = FALSE)
entry <- attr(tr, "quality")$initiate[[1]]
expect_false(is.null(entry$step_id))
expect_false(is.null(entry$package_version))
expect_false(is.null(entry$timestamp))
expect_false(is.null(entry$rows_after))
expect_false(is.null(entry$cols_after))
})
test_that("initiate() quality log is a list-of-run-entries (list of lists)", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
utils::write.csv(
data.frame(unix_time = t0 + seq_len(20), lat = 51.5, lng = -0.1, altitude = 10),
path, row.names = FALSE
)
tr   <- initiate(source = "guess_csv", session = path, verbose = FALSE)
qual <- attr(tr, "quality")
expect_true(is.list(qual$initiate))
expect_true(is.list(qual$initiate[[1]]))
expect_equal(qual$initiate[[1]]$step, "initiate")
})
test_that("initiate() metadata records coordinate_system = 'local' for XY", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
n <- 30
utils::write.csv(
data.frame(unix_time = t0 + seq_len(n), x = seq_len(n), y = seq_len(n) * 0.5, z = 0),
path, row.names = FALSE
)
tr   <- initiate(source = "guess_csv", session = path,
coord_system = "local", verbose = FALSE)
meta <- attr(tr, "metadata")
expect_equal(meta$coordinate_system, "local")
expect_false(is.null(meta$native_hz))
})
test_that("initiate() metadata source is 'template_csv' when template supplied", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
utils::write.csv(
data.frame(T = t0 + seq_len(20), La = 51.5, Lo = -0.1, Al = 10),
path, row.names = FALSE
)
tmpl <- csv_template(col_unix = "T", col_lat = "La", col_lng = "Lo")
tr   <- suppressMessages(
initiate(session = path, template = tmpl, verbose = FALSE)
)
expect_equal(attr(tr, "metadata")$source, "template_csv")
})
test_that("initiate() errors on a nonexistent file", {
expect_error(
initiate(source = "guess_csv", session = "/nonexistent/path/data.csv", verbose = FALSE),
"not found|File not found",
ignore.case = TRUE
)
})
test_that("initiate() errors on a file with no CSV structure", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
writeLines(c("this is not a csv file at all", "no commas here"), path)
expect_error(
initiate(source = "guess_csv", session = path, verbose = FALSE),
"No valid CSV structure|structure"
)
})
test_that("initiate() handles altitude-free GPS CSV (altitude column filled NA)", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
n <- 30
data_rows <- paste(t0 + seq_len(n), 51.5, -0.1, sep = ",")
writeLines(c("unix_time,lat,lng", data_rows), path)
tr <- initiate(source = "guess_csv", session = path, verbose = FALSE)
expect_s3_class(tr, "motion_trace")
expect_true("altitude" %in% names(tr))
expect_true(all(is.na(tr$altitude)))
})
test_that("initiate() handles Windows CRLF line endings", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
n <- 20
lines <- c(
"unix_time,lat,lng,altitude",
paste(t0 + seq_len(n), 51.5, -0.1, 10, sep = ",")
)
writeBin(chartr("\n", "\r\n", paste(lines, collapse = "\n")), path)
tr <- suppressWarnings(
initiate(source = "guess_csv", session = path, verbose = FALSE)
)
expect_s3_class(tr, "motion_trace")
expect_equal(nrow(tr), n)
})
