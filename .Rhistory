method = "corbett"
)
table(trace$designation)
trace <- trace |>
designate(v_threshold = 0.3,
method = "corbett")
ggplot(as.data.frame(trace), aes(x = unix_time, y = velocity, colour = designation)) +
geom_line(linewidth = 0.4) +
labs(title = "Velocity coloured by designation",
x = "Time (s)", y = "Velocity (m/s)", colour = "Segment") +
theme_minimal() +
theme(panel.grid = element_blank(),
legend.position = "bottom")
trace <- trace |>
allocate(
allocation = list(
velocity = c(0, 2, 4, 6, 8),
acceleration = c(0, 1, 2, 3, 4),
angular_velocity = c(0,90,180)
),
allocation_name = "gps_standard"
)
# Band distribution for velocity
table(trace$gps_standard_velocity_band)
trace <- trace |>
allocate(allocation = list(
velocity = c(0, 2, 4, 6, 8),
acceleration = c(0, 1, 2, 3, 4),
angular_velocity = c(0,90,180)),
allocation_name = "gps_standard"
)
summary_tbl <- trace |>
quantitate(
allocation = "gps_standard",
derivative = "velocity",
scope = "designation",
active_only = FALSE,
n_frames = dplyr::n(),
time_s = dplyr::n() / 10,
dist_m = sum(distance, na.rm = TRUE),
mean_vel = mean(velocity, na.rm = TRUE)
)
summary_tbl
session_totals <- trace |>
quantitate(allocation = "gps_standard",
derivative = "velocity",
scope = "session",
time_s = dplyr::n() / 10,
dist_m = sum(distance, na.rm = TRUE),
peak_vel = max(velocity, na.rm = TRUE))
session_totals
?quantitate
