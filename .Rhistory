trace <- trace |>
derivate(use_filtered = TRUE,
derivatives = c("velocity",
"acceleration",
"angular_velocity")
)
summary(trace[, c("velocity", "acceleration", "angular_velocity")])
ggplot(as.data.frame(trace), aes(x = unix_time, y = angular_velocity)) +
geom_line(linewidth = 0.3, colour = "#0072B2") +
labs(title = "Velocity profile", x = "Time (s)", y = "Velocity (m/s)") +
theme_minimal() +
theme(panel.grid = element_blank())
trace |>
drop_na(angular_velocity) |>
ggplot(aes(x = unix_time,
y = angular_velocity)) +
geom_line(linewidth = 0.3,
colour = "black") +
labs(title = "Angular Velocity",
x = "Time (s)",
y = "Angular Velocity (deg/s)") +
theme_minimal() +
theme(panel.grid = element_blank())
trace |>
drop_na(angular_velocity) |>
ggplot(aes(x = unix_time,
y = angular_velocity)) +
geom_line(linewidth = 0.3,
colour = "black") +
labs(title = "Angular Velocity",
x = "Time (s)",
y = "Angular Velocity (deg/s)") +
theme_minimal() +
theme(panel.grid = element_blank())
trace |>
