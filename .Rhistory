# This vignette assumes the demo files live in inst/extdata when installed.
# During package development, it falls back to ../data.
path <- system.file(
"extdata",
"marquee_gps_file.csv",
package = "motiongrammar"
)
if (path == "") {
path <- file.path("..", "data", "marquee_gps_file.csv")
}
designation_path <- system.file(
"extdata",
"marquee_designations.csv",
package = "motiongrammar"
)
if (designation_path == "") {
designation_path <- file.path("..", "data", "marquee_designations.csv")
}
allocation_path <- system.file(
"extdata",
"marquee_allocations.csv",
package = "motiongrammar"
)
if (allocation_path == "") {
allocation_path <- file.path("..", "data", "marquee_allocations.csv")
}
stopifnot(file.exists(path))
