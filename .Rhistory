# tests/testthat/test-api-import.R
test_that("api_stream_template() validates required fields", {
expect_error(
api_stream_template(api = "strava"),
"stream_time"
)
expect_error(
api_stream_template(
api = "generic",
stream_time = "time",
stream_lat = "lat",
stream_lng = "lng"
),
"url"
)
expect_error(
api_stream_template(
api = "generic",
url = "https://example.com/{session}",
stream_time = "time",
coord_system = "gps"
),
"requires stream_latlng|stream_lat"
)
expect_error(
api_stream_template(
api = "generic",
url = "https://example.com/{session}",
stream_time = "time",
coord_system = "local",
stream_x = "x"
),
"requires stream_y"
)
})
