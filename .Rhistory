test_that("initiate() parses device-export CSV with single-line preamble", {
path <- tempfile(fileext = ".csv")
on.exit(unlink(path))
n <- 50
# Data rows have a trailing comma (4 commas), header has 3 commas (4 cols).
# guess_csv sees most-frequent count = 4, searches backwards for header,
# finds the last alphabetic row before the data block.
data_rows <- paste0(
t0 + seq(0, by = 0.2, length.out = n), ",",
51.5 + seq(0, 0.005, length.out = n), ",",
-0.1 + seq(0, 0.005, length.out = n), ",",
12, ","        # trailing comma → 4 commas per row
)
writeLines(c(
"SportTracker Export,Version 3.2",   # 1 comma — preamble
"Timestamp,Latitude,Longitude,Altitude",  # 3 commas — header
data_rows                             # 4 commas — data
), path)
tr <- initiate(source = "guess_csv", session = path, verbose = FALSE)
expect_s3_class(tr, "motion_trace")
expect_equal(nrow(tr), n)
expect_true(all(!is.na(tr$lat)))
})
